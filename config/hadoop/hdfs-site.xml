<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<configuration>
  <!-- He so nhan ban = 1 vi cum chi co 1 DataNode (pseudo-distributed) -->
  <property>
    <name>dfs.replication</name>
    <value>1</value>
  </property>

  <!-- Noi NameNode luu fsimage + edits log -->
  <property>
    <name>dfs.namenode.name.dir</name>
    <value>file:///home/thomm/hadoopdata/hdfs/namenode</value>
  </property>

  <!-- Noi DataNode luu cac block du lieu -->
  <property>
    <name>dfs.datanode.data.dir</name>
    <value>file:///home/thomm/hadoopdata/hdfs/datanode</value>
  </property>

  <!-- Kich thuoc block mac dinh: 128 MB -->
  <property>
    <name>dfs.blocksize</name>
    <value>134217728</value>
  </property>

  <!-- Giao dien Web UI cua NameNode -->
  <property>
    <name>dfs.namenode.http-address</name>
    <value>0.0.0.0:9870</value>
  </property>

  <!-- Giao dien Web UI cua DataNode -->
  <property>
    <name>dfs.datanode.http.address</name>
    <value>0.0.0.0:9864</value>
  </property>

  <!-- Tat kiem tra quyen HDFS cho moi truong thu nghiem 1 nguoi dung -->
  <property>
    <name>dfs.permissions.enabled</name>
    <value>false</value>
  </property>
</configuration>
